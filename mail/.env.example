# copy to .env and fill in. never commit .env.

# public url of this server (used for the google redirect: BASE_URL/auth/callback)
BASE_URL=http://localhost:8787
PORT=8787

# google cloud console → apis & services → credentials → oauth client (web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console.anthropic.com → api keys
ANTHROPIC_API_KEY=

# 32+ random characters. signs sessions and encrypts stored google tokens.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# who may sign in (comma separated). empty = nobody, unless OPEN_SIGNUP=1.
ALLOWED_EMAILS=
OPEN_SIGNUP=0

# claude model for triage + drafts
CLAUDE_MODEL=claude-opus-5-5

# how often the inbox is cleaned (minutes). 0 = only on "clean now" / npm run triage.
TRIAGE_EVERY_MINUTES=30
# max inbox threads looked at per run
TRIAGE_MAX_THREADS=50
# 1 = look and log, change nothing in gmail. start with this.
TRIAGE_DRY_RUN=1
# optional: archive inbox threads older than n days without ai (labelled zero/old). empty = off.
ARCHIVE_OLDER_THAN_DAYS=

DATA_DIR=./data
