{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/pact",
      "destination": "https://purmethod.com/pure/pact"
    },
    {
      "source": "/pure",
      "destination": "https://purmethod.com/pure"
    },
    {
      "source": "/pure/",
      "destination": "https://purmethod.com/pure"
    },
    {
      "source": "/pure/:path+",
      "destination": "https://purmethod.com/pure/:path+"
    }
  ],
  "redirects": [
    {
      "source": "/soma",
      "destination": "https://myfoyo.com/",
      "permanent": false
    },
    {
      "source": "/soma/:path*",
      "destination": "https://myfoyo.com/",
      "permanent": false
    },
    {
      "source": "/pakt",
      "destination": "/pact",
      "permanent": false
    },
    {
      "source": "/:lang(de|fr|es|ar|ru)/pact",
      "destination": "/pact",
      "permanent": false
    },
    {
      "source": "/:lang(de|fr|es|ar|ru)/pakt",
      "destination": "/pact",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/((?!pure|pact).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://*.stripe.com; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
