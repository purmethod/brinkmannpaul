# ---------------------------------------------------------------- Frontend (build time, public)
# Absolute URL of the backend. Web: the Vercel domain. Native apps: the same URL.
NEXT_PUBLIC_API_BASE=https://cyclemax.app

# ---------------------------------------------------------------- Backend (server only, secret)
# Claude – never exposed to the client. Without a key the mentor answers from the knowledge base.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: low | medium | high (empty = model default). Default low = short, fast chat answers.
CLAUDE_EFFORT=low
# Optional: effort for profile analysis + knowledge job (default medium)
CLAUDE_JSON_EFFORT=medium
# Optional: max Claude calls per day for the whole app (cost protection, default 3000)
CLAUDE_DAILY_LIMIT=3000
# Optional: "off" disables Anthropic server-side refusal fallbacks (default on for Sonnet 5.5 / Opus 5.x / Fable 5.1).
CLAUDE_FALLBACKS=

# Neon Postgres. Empty = local SQLite file (.data/cyclemax.db; on Vercel /tmp, i.e. NOT persistent).
DATABASE_URL=

# Web push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@brinkmannpaul.com

# /admin password (Bearer). Empty = admin closed.
ADMIN_PASSWORD=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Required in production.
CRON_SECRET=

# Optional tuning
PUSH_LEAD_MINUTES=30
PUSH_STALE_MINUTES=180
