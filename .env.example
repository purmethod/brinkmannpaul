# Server environment only. Never put a real secret in this file or dist/.
# Set these in Vercel project settings. Local dev can export them in its shell.
SITE_URL=https://brinkmannpaul.com
STRIPE_SECRET_KEY=
SHOP_ENABLED=false

# Explicit launch gates. These flags do not implement fulfillment or policies.
# Confirm actual order handling, stock management, digital delivery and seller
# / purchase information before setting them to true. Manual fulfillment via
# Stripe Dashboard is possible; no automated delivery exists in this project.
SHOP_FULFILLMENT_READY=false
SHOP_POLICIES_READY=false

# Physical goods only: a confirmed comma-separated list of ISO country codes,
# and 1–5 existing Stripe shipping rate IDs for rates applicable to ALL listed
# countries. Shipping rates must use the same currency as the cart.
SHIPPING_ALLOWED_COUNTRIES=
STRIPE_SHIPPING_RATE_IDS=

# Product setup lives in shop/products.json. Each real SKU needs a confirmed
# title, description, digital/physical kind, unitAmount in minor currency units,
# lowercase currency, an existing Stripe price ID and a safe maximum quantity.
# Supported currencies: eur, usd, gbp, chf (all use two decimal places).
# At most four distinct product lines per cart; quantity caps are not inventory.
# Keep active:false and confirmed:false until all these details are supplied.
# The initial maxQuantity:1 is only a safety cap, not a stock assertion.
# Books must first be identified as a particular printed or digital edition.
