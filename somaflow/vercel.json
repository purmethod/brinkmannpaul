{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/preview",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/preview/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/((?!soon/).*)",
      "has": [
        {
          "type": "host",
          "value": "somaflowclub.com"
        }
      ],
      "destination": "https://somaflowclub.com/soon/",
      "permanent": false
    },
    {
      "source": "/((?!soon/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.somaflowclub.com"
        }
      ],
      "destination": "https://somaflowclub.com/soon/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/club/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
